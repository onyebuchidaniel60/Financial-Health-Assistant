    {
      "parameters": {
        "jsCode": "// This Function node runs *once for all items*\n// Assumes previous Merge node (or separate input nodes) have been combined into one stream\n\n// Get all items from the previous node\nconst items = $input.all();\n\n// Extract and group data\nconst incomeStatement  = [];\nconst cashFlow         = [];\nlet   balanceSheet     = {};\n\nfor (const item of items) {\n  const json = item.json;\n\n  // Check for monthly income statement row\n  if (json.Month && json.Revenue !== undefined && json.netProfit !== undefined) {\n    incomeStatement.push({\n      month:             json.Month,\n      revenue:           json.Revenue,\n      cogs:              json.Cogs ?? null,\n      grossProfit:       json.grossProfit ?? null,\n      operatingExpenses: json.operatingExpenses ?? null,\n      netProfit:         json.netProfit\n    });\n    continue;\n  }\n\n  // Check for cash-flow row\n  if (json.Quarter && json.operatingCashFlow !== undefined && json.netCashChange !== undefined) {\n    cashFlow.push({\n      quarter:   json.Quarter,\n      operating: json.operatingCashFlow,\n      investing: json.InvestingCashFlow ?? null,\n      financing: json.financingCashFlow ?? null,\n      netChange: json.netCashChange\n    });\n    continue;\n  }\n\n  // Check for balance sheet snapshot\n  if (json.totalAssets !== undefined && json.totalLiabilities !== undefined) {\n    balanceSheet = {\n      assets: {\n        cash:               json.cash               ?? null,\n        accountsReceivable: json.accountsReceivable ?? null,\n        inventory:          json.inventory          ?? null,\n        equipmentNet:       json.equipmentNet       ?? null,\n        totalAssets:        json.totalAssets\n      },\n      liabilities: {\n        accountsPayable: json.accountsPayable ?? null,\n        bankLoan:        json.bankLoan        ?? null,\n        totalLiabilities:json.totalLiabilities\n      },\n      equity: {\n        ownerEquity:             json.ownerEquity             ?? null,\n        totalLiabilitiesAndEquity: json.totalLiabilitiesAndEquity ?? null\n      }\n    };\n  }\n}\n\n// Build the output item\nreturn [\n  {\n    json: {\n      incomeStatement,\n      cashFlow,\n      balanceSheet\n      \n    }\n  }\n];\n"
      },
